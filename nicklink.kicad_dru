(version 1)

# JLCPCB 2-layer limits (jlcpcb.com/capabilities/pcb-capabilities, checked 2026-10-01)
# that KiCad's board-level constraints don't express. The board setup (nicklink.kicad_pro)
# carries the rest: 0.10 mm min track, 0.13 mm clearance, 0.3 mm edge clearance
# (Economic PCBA), 0.15 mm silk clearance, 0.10 mm solder-mask web.

(rule "JLC: component PTH annular ring >= 0.18 mm"
  (constraint annular_width (min 0.18mm))
  (condition "A.Type == 'Pad'"))

(rule "JLC: SMD pad to pad >= 0.15 mm"
  (constraint clearance (min 0.15mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'"))

(rule "JLC: pad hole to pad hole >= 0.45 mm"
  (constraint hole_to_hole (min 0.45mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "JLC: plated slot width >= 0.5 mm"
  (constraint hole_size (min 0.5mm))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y"))

# JLC specifies silk-to-pad (0.15 mm) but not silk-to-silk; with footprint outlines widened
# to JLC's 0.15 mm minimum line width, allow 0.10 mm between silkscreen items themselves.
(rule "silk to silk"
  (constraint silk_clearance (min 0.1mm))
  (condition "A.Layer == B.Layer && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')"))

# USB4085 0.85 mm pitch with 0.74 mm pads (0.38 mm holes, inside GCT's 0.40 +-0.05 spec) leaves
# 0.11 mm between its own pads: above JLC's 0.10 mm minimum spacing, below the 0.13 mm default.
(rule "USB4085 pad pitch"
  (constraint clearance (min 0.1mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('J2') && B.memberOfFootprint('J2')"))
